<%-include('../cabecalho.ejs')%>
       <section class="col-12 col-md-10">
            
            <div class="card my-4">
                <div class="card-header">
                  Lista de Usuarios
                </div>
                <div class="card-body">
                  
                    <table class="table table-striped table-dark">
                        <thead>
                          <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Nome</th>
                            <th scope="col">Email</th>
                            <th scope="col">Foto</th>
                            <th scope="col">Detalhe</th>
                          </tr>
                        </thead>
                        <tbody>
                            <%usuarios.forEach(function(usuario){%>
                                <tr>
                            <th scope="row"> <%=usuario._id%> </th>
                            <td><%=usuario.nome%></td>
                            <td><%=usuario.email%></td>
                            <td><%=usuario.foto%></td>
                            <td>
                                <a href="/admin/usuarios/detalhe/<%=usuario._id%>">Detalhe</a>
                            </td>
                          </tr>
                            
                            <%})%>
                         
                        </tbody>
                      </table>
                    
                </div>
              </div>

        </section>
        <%-include('../rodape.ejs')%>